    /* ==========================================================================
       2. 情境問答題目庫 (Micro-Quiz)
       ========================================================================== */
    const quizDB = [
      {
        q: "生態調查時，你在操場旁的草皮上發現一隻身形像母雞的大鳥，站在原地一動也不動維持了整整兩分鐘，牠最可能是誰？正在做什麼？",
        options: [
          { text: "麻雀，正在躲避貓咪追捕", isCorrect: false },
          { text: "黑冠麻鷺，正在擬態枯木並感應土壤中的蚯蚓", isCorrect: true },
          { text: "白尾八哥，正在休息曬太陽", isCorrect: false },
