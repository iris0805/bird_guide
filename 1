    /* ==========================================================================
       3. Web Audio API 物理鳥鳴聲合成器 (零依賴、無外網相容)
       ========================================================================== */
    let audioCtx = null;

    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // 播放指定鳥種的程序化合成音
    function playBirdAcoustic(soundType) {
      try {
        const ctx = getAudioContext();
        const now = ctx.currentTime;
        const statusEl = document.getElementById('audio-status');
        statusEl.innerText = "發聲中...";

        if (soundType === 'chirp-short') {
          // 麻雀：雙次短促高頻震盪 (3.2kHz -> 2.1kHz)
          for (let i = 0; i < 2; i++) {
            const start = now + (i * 0.16);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(3200, start);
            osc.frequency.exponentialRampToValueAtTime(2100, start + 0.08);

            gain.gain.setValueAtTime(0, start);
            gain.gain.linearRampToValueAtTime(0.3, start + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.001, start + 0.08);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.09);
          }
        } else if (soundType === 'bulbul-triplet') {
          // 白頭翁：三連滑音 (巧克力～)
          const notes = [1700, 2300, 1950];
          notes.forEach((freq, idx) => {
            const start = now + (idx * 0.14);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, start);
            osc.frequency.linearRampToValueAtTime(freq + 200, start + 0.06);
            osc.frequency.linearRampToValueAtTime(freq - 150, start + 0.12);

            gain.gain.setValueAtTime(0.01, start);
            gain.gain.linearRampToValueAtTime(0.25, start + 0.03);
            gain.gain.linearRampToValueAtTime(0.001, start + 0.13);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.14);
          });
        } else if (soundType === 'white-eye-bell') {
          // 綠繡眼：細碎鈴鐺微鳴 (4.5kHz ~ 5.2kHz 超高頻)
          for (let i = 0; i < 3; i++) {
            const start = now + (i * 0.11);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(4600 + (i * 200), start);
            osc.frequency.linearRampToValueAtTime(5300, start + 0.04);
            osc.frequency.linearRampToValueAtTime(4200, start + 0.08);

            gain.gain.setValueAtTime(0.01, start);
            gain.gain.linearRampToValueAtTime(0.18, start + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, start + 0.08);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.09);
          }
        } else if (soundType === 'black-bulbul-meow') {
          // 紅嘴黑鵯：擬貓叫滑音 (2.2kHz 下滑到 1.1kHz)
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth'; // 略帶沙啞質感
          osc.frequency.setValueAtTime(1400, now);
          osc.frequency.linearRampToValueAtTime(2100, now + 0.18);
          osc.frequency.exponentialRampToValueAtTime(1100, now + 0.55);

          gain.gain.setValueAtTime(0.01, now);
          gain.gain.linearRampToValueAtTime(0.2, now + 0.15);
          gain.gain.linearRampToValueAtTime(0.15, now + 0.4);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.56);
        } else if (soundType === 'heron-deep-boom') {
          // 黑冠麻鷺：低沉喉鳴共振 (140Hz)
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(135, now);
          osc.frequency.linearRampToValueAtTime(145, now + 0.15);
          osc.frequency.linearRampToValueAtTime(125, now + 0.4);

          gain.gain.setValueAtTime(0.01, now);
          gain.gain.linearRampToValueAtTime(0.35, now + 0.08);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.45);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.46);
        } else if (soundType === 'myna-chatter') {
          // 白尾八哥：兩段刺耳金屬音 (1.2kHz 與 1.8kHz 快速交錯)
          [1100, 1650].forEach((freq, i) => {
            const start = now + (i * 0.12);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'square'; // 金屬感
            osc.frequency.setValueAtTime(freq, start);
            osc.frequency.linearRampToValueAtTime(freq - 200, start + 0.1);

            gain.gain.setValueAtTime(0.01, start);
            gain.gain.linearRampToValueAtTime(0.12, start + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, start + 0.1);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.11);
          });
        }

        setTimeout(() => {
          statusEl.innerText = "播放完畢";
        }, 600);
      } catch (err) {
        console.warn("AudioContext 播放異常：", err);
      }
    }

    /* ==========================================================================
       4. 狀態管理與 UI 控制邏輯
       ========================================================================== */
    let currentFilter = 'all';
    let selectedBirdId = 'sparrow';
    let currentQuizIndex = 0;

    const layers = [
      { id: 'all', label: '全部顯示', icon: '🔍' },
      { id: 'ground', label: '🌱 地面草皮層', icon: '🌱' },
      { id: 'shrub', label: '🌿 灌木綠籬層', icon: '🌿' },
      { id: 'canopy', label: '🌳 喬木樹冠層', icon: '🌳' },
      { id: 'building', label: '🏢 人造建物層', icon: '🏢' }
    ];

    // 初始化微棲地過濾按鈕
    function renderFilterButtons() {
      const container = document.getElementById('layer-filters');
      container.innerHTML = '';

      layers.forEach(l => {
        const btn = document.createElement('button');
        btn.className = `touch-target flex-shrink-0 px-3.5 py-2 rounded-xl text-xs font-bold transition active-scale ${
          currentFilter === l.id 
            ? 'bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20' 
            : 'bg-slate-800 text-slate-300 border border-slate-700/80 hover:bg-slate-700'
        }`;
        btn.innerText = l.label;
        btn.onclick = () => {
          currentFilter = l.id;
          renderFilterButtons();
          renderBirdCards();
        };
        container.appendChild(btn);
      });
    }

    // 渲染卡片清單
    function renderBirdCards() {
      const grid = document.getElementById('bird-grid');
      grid.innerHTML = '';

      const filtered = birdDB.filter(b => currentFilter === 'all' || b.category === currentFilter);
      document.getElementById('filtered-count').innerText = `共 ${filtered.length} 種`;

      filtered.forEach(bird => {
        const isSelected = bird.id === selectedBirdId;
        const card = document.createElement('div');
        card.className = `touch-target p-3.5 rounded-2xl cursor-pointer transition active-scale border-2 flex flex-col justify-between ${
          isSelected 
            ? 'bg-slate-800 border-amber-500 shadow-lg shadow-amber-500/10' 
            : 'bg-slate-800/60 border-slate-700/80 hover:border-slate-600'
        }`;
        card.onclick = () => selectBird(bird.id);

        card.innerHTML = `
          <div class="flex items-center justify-between mb-2">
            <span class="text-3xl">${bird.avatar}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md ${bird.tagColor}">
              ${bird.tag}
            </span>
          </div>
          <div>
            <h3 class="font-black text-sm text-slate-100">${bird.name}</h3>
            <p class="text-[11px] text-slate-400 truncate mt-0.5">${bird.habitat.split('、')[0]}</p>
          </div>
        `;
        grid.appendChild(card);
      });

      // 如果篩選後原本選中的不在清單內，預設選取第一個
      if (filtered.length > 0 && !filtered.some(b => b.id === selectedBirdId)) {
        selectBird(filtered[0].id);
      }
    }

    // 選取鳥類並同步詳細面板
    function selectBird(birdId) {
      selectedBirdId = birdId;
      const bird = birdDB.find(b => b.id === birdId);
      if (!bird) return;

      document.getElementById('detail-avatar').innerText = bird.avatar;
      document.getElementById('detail-name').innerText = bird.name;
      document.getElementById('detail-tag').innerText = bird.tag;
      document.getElementById('detail-tag').className = `text-xs px-2 py-0.5 rounded-full font-bold ${bird.tagColor}`;
      document.getElementById('detail-habitat').innerText = `微棲地：${bird.habitat}`;
      document.getElementById('detail-eyes').innerText = bird.eyes;
      document.getElementById('detail-habits').innerText = bird.habits;
      document.getElementById('detail-sound-desc').innerText = bird.soundDesc;

      // 重新繪製卡片的外框狀態
      renderBirdCards();
    }

    // 觸發擬音播放
    function triggerBirdSound() {
      const bird = birdDB.find(b => b.id === selectedBirdId);
      if (bird) {
        playBirdAcoustic(bird.soundType);
      }
    }

    /* ==========================================================================
       5. 互動測驗模組 (Micro-Quiz)
       ========================================================================== */
    function renderQuiz() {
      const qData = quizDB[currentQuizIndex];
      document.getElementById('quiz-progress').innerText = `第 ${currentQuizIndex + 1} / ${quizDB.length} 題`;
      document.getElementById('quiz-question').innerText = qData.q;
      
      const optContainer = document.getElementById('quiz-options');
      optContainer.innerHTML = '';

      const feedback = document.getElementById('quiz-feedback');
      feedback.className = 'hidden';
      document.getElementById('btn-next-quiz').classList.add('hidden');

      qData.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "touch-target w-full text-left p-3.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-200 text-xs md:text-sm font-medium hover:bg-slate-700/80 transition active-scale";
        btn.innerText = `${String.fromCharCode(65 + idx)}. ${opt.text}`;
        btn.onclick = () => submitQuizAnswer(opt.isCorrect, qData.explanation, btn);
        optContainer.appendChild(btn);
      });
    }

    function submitQuizAnswer(isCorrect, explanation, selectedBtn) {
      const feedback = document.getElementById('quiz-feedback');
      const allButtons = document.querySelectorAll('#quiz-options button');
      allButtons.forEach(b => b.disabled = true);

      if (isCorrect) {
        selectedBtn.classList.remove('bg-slate-800', 'border-slate-700');
        selectedBtn.classList.add('bg-emerald-950', 'border-emerald-500', 'text-emerald-200');
        feedback.className = "mt-4 p-3.5 rounded-xl border bg-emerald-950/60 border-emerald-800 text-emerald-300 text-xs leading-relaxed block";
        feedback.innerHTML = `<strong>🎉 答對了！</strong> ${explanation}`;
      } else {
        selectedBtn.classList.remove('bg-slate-800', 'border-slate-700');
        selectedBtn.classList.add('bg-rose-950', 'border-rose-500', 'text-rose-200');
        feedback.className = "mt-4 p-3.5 rounded-xl border bg-rose-950/60 border-rose-800 text-rose-300 text-xs leading-relaxed block";
        feedback.innerHTML = `<strong>💡 需要再觀察喔！</strong> ${explanation}`;
      }

      document.getElementById('btn-next-quiz').classList.remove('hidden');
    }

    function nextQuizQuestion() {
      currentQuizIndex = (currentQuizIndex + 1) % quizDB.length;
      renderQuiz();
    }

    /* ==========================================================================
       6. 頁籤切換系統 (圖鑑 vs 測驗)
       ========================================================================== */
    function switchMainTab(tab) {
      const fieldSec = document.getElementById('section-field');
      const quizSec = document.getElementById('section-quiz');
      const btnField = document.getElementById('btn-tab-field');
      const btnQuiz = document.getElementById('btn-tab-quiz');

      if (tab === 'field') {
        fieldSec.classList.remove('hidden');
        quizSec.classList.add('hidden');
        btnField.className = "touch-target px-3.5 py-1.5 text-xs font-bold rounded-lg bg-amber-500 text-slate-950 transition-colors";
        btnQuiz.className = "touch-target px-3.5 py-1.5 text-xs font-bold rounded-lg text-slate-300 hover:text-white transition-colors";
      } else {
        fieldSec.classList.add('hidden');
        quizSec.classList.remove('hidden');
        btnQuiz.className = "touch-target px-3.5 py-1.5 text-xs font-bold rounded-lg bg-amber-500 text-slate-950 transition-colors";
        btnField.className = "touch-target px-3.5 py-1.5 text-xs font-bold rounded-lg text-slate-300 hover:text-white transition-colors";
        renderQuiz();
      }
    }

    // 頁面載入時初始化
    window.addEventListener('DOMContentLoaded', () => {
      renderFilterButtons();
      renderBirdCards();
      selectBird('sparrow');
    });
  </script>
</body>
